{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A chat message sent by a user or the AI bot",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the message"
        },
        "text": {
          "type": "string",
          "description": "The textual content of the message"
        },
        "userId": {
          "type": "string",
          "description": "UID of the message author"
        },
        "userName": {
          "type": "string",
          "description": "Name of the message author"
        },
        "userPhoto": {
          "type": "string",
          "description": "Profile picture URL of the message author"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "isAi": {
          "type": "boolean",
          "description": "True if the message is generated by the AI companion"
        },
        "thinkingText": {
          "type": "string",
          "description": "Reasoning process of the AI model"
        }
      },
      "required": ["id", "text", "userId", "userName", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A registered chat participant",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier of the user"
        },
        "displayName": {
          "type": "string",
          "description": "The user's chosen display name"
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile picture"
        },
        "email": {
          "type": "string",
          "description": "The user's registered email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user registered"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Global collection for public chat messages"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "A collection containing public user profiles"
    }
  }
}
