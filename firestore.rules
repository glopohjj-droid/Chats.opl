rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // Mandate email verification for core write actions
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Messages Collection Security Rules
    match /messages/{messageId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.id is string;
      
      // Creating a message
      allow create: if isEmailVerified() 
        && isValidId(messageId) 
        && messageId == incoming().id
        && isValidMessage(incoming())
        && (incoming().userId == request.auth.uid || (incoming().userId == "ai-assistant" && incoming().isAi == true));
        
      allow update: if false; // Messages are immutable
      allow delete: if false; // Messages cannot be deleted in public chat
    }

    // Users Collection Security Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid is string;
      
      allow create: if isEmailVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && userId == incoming().uid
        && isValidUser(incoming())
        && incoming().createdAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && userId == incoming().uid
        && isValidUser(incoming())
        // Immutable after creation
        && incoming().createdAt == existing().createdAt
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email']);
        
      allow delete: if false;
    }

    // Message validation helper
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'text', 'userId', 'userName', 'createdAt'])
        && data.keys().size() >= 5 
        && data.keys().size() <= 8
        && data.id is string && data.id.size() <= 128
        && data.text is string && data.text.size() <= 50000
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 200
        && data.createdAt == request.time
        && (!('userPhoto' in data) || (data.userPhoto is string && data.userPhoto.size() <= 2000))
        && (!('isAi' in data) || data.isAi is bool)
        && (!('thinkingText' in data) || (data.thinkingText is string && data.thinkingText.size() <= 1000000));
    }

    // User validation helper
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt'])
        && data.keys().size() >= 4
        && data.keys().size() <= 5
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 200
        && data.email is string && data.email.size() <= 320
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000));
    }
  }
}
